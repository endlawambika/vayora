# Vayora checkout secrets. Copy to supabase/.env, fill in, then:  supabase secrets set --env-file supabase/.env
# Never commit the filled-in file. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically on Supabase.

# --- Razorpay (Dashboard → Account & Settings → API Keys; use Test Mode keys first) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL https://<project-ref>.supabase.co/functions/v1/razorpay-webhook
# events: payment.captured, payment.failed, order.paid ; the secret you type there goes here
RAZORPAY_WEBHOOK_SECRET=

# --- Product and pricing (server-side; the website's numbers are display only) ---
PRODUCT_PRICE_INR=4999
SHIPPING_FEE_INR=0
TAX_RATE_PERCENT=0
MAX_QUANTITY=5
PRODUCT_NAME=Vayora – Portable All-in-One Personal Comfort Device

# --- Email: brevo or resend ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
# Must be a sender you have verified with the provider (Brevo: Senders; Resend: a verified domain)
EMAIL_FROM=Team Vayora <your-verified-sender@example.com>
# Where new-order notifications go
ADMIN_EMAIL=

# --- Website ---
# Your live site address, no trailing slash (used for the logo in emails)
SITE_URL=https://<your-username>.github.io/<your-repo>
# Restrict browser calls to your site (comma-separated), or * while testing
ALLOWED_ORIGIN=https://<your-username>.github.io
SUPPORT_PHONE=9999555555
